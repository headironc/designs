[Unit]
Description=Nucleiron isolated VM firewall
DefaultDependencies=no
After=local-fs.target ufw.service
Before=snap.lxd.daemon.service snap.lxd.daemon.unix.socket
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/nucleus-halo/bin/runner-firewall
ExecReload=/opt/nucleus-halo/bin/runner-firewall
# Stopping the unit deliberately retains the protective rules.

[Install]
WantedBy=multi-user.target
