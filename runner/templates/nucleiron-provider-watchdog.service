[Unit]
Description=Stop Nucleiron admission after provider or storage failure
After=nucleiron.service

[Service]
Type=oneshot
ExecStart=/opt/nucleus-halo/bin/provider-watchdog
TimeoutStartSec=170
UMask=0077
StateDirectory=nucleiron-watchdog
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nucleiron
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET
LogNamespace=nucleus-halo
